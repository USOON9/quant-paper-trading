# Only PAPER credentials belong here. Never paste live credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Required in addition to credentials before the gateway can submit paper orders.
ENABLE_ALPACA_PAPER=NO

# Separate gate for a buy-then-sell paper round trip.
ENABLE_ALPACA_PAPER_ROUND_TRIP=NO

# Required by SEC fair-access policy: identify the application and contact.
SEC_USER_AGENT=QuantPaperResearch your_email@example.com

# Create a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
